#!/bin/bash
# ENVIRONMENT.example — aio-proxmox v4.2
# Copy this file to ENVIRONMENT and edit values for your setup
# ============================================================

# ------------------------------------------------------------
# P2 FLEXIBLE PLACEMENT PER SERVICE
# Valid values for *_INSTALL_MODE:
#   ask         - interactive prompt at runtime (default)
#   host        - install directly on Proxmox host
#   lxc-new     - install in new LXC container (uses default IP/CTID below)
#   lxc-existing - install in existing LXC (must set *_TARGET_CTID)
# ------------------------------------------------------------
CLOUDFLARED_INSTALL_MODE='host'
TAILSCALE_INSTALL_MODE='host'
MIHOMO_INSTALL_MODE='host'
TTYD_INSTALL_MODE='host'
OHMYZSH_INSTALL_MODE='host'
FASTFETCH_INSTALL_MODE='host'
HEALTHCHECK_INSTALL_MODE='host'
MIKROTIK_CHR_INSTALL_MODE='vm'  # VM, not LXC â€” doesn't follow P2
ROUTER9_INSTALL_MODE='ask'
HEADROOM_INSTALL_MODE='ask'       # default: co-locate with 9Router if lxc-new
HERMES_INSTALL_MODE='ask'
HERMES_WEBUI_INSTALL_MODE='ask'   # replaces Open WebUI
STORAGE_MANAGER_INSTALL_MODE='ask'
COPYPARTY_INSTALL_MODE='ask'
XUI_INSTALL_MODE='ask'            # 3x-ui (Xray panel)

ROUTER9_TARGET_CTID=''
HEADROOM_TARGET_CTID=''
HERMES_TARGET_CTID=''
HERMES_WEBUI_TARGET_CTID=''
STORAGE_MANAGER_TARGET_CTID=''
COPYPARTY_TARGET_CTID=''
XUI_TARGET_CTID=''

# --- TOGGLE: yes|no|ask ---
INSTALL_CLOUDFLARED='ask'
INSTALL_TAILSCALE='ask'
INSTALL_MIHOMO='ask'
INSTALL_9ROUTER='ask'
INSTALL_HEADROOM='ask'
INSTALL_HERMES_WEBUI='ask'
INSTALL_STORAGE_MANAGER='ask'
INSTALL_XUI='ask'
INSTALL_TTYD='ask'
INSTALL_OHMYZSH='ask'
INSTALL_FASTFETCH='ask'
INSTALL_HEALTHCHECK='ask'

UPDATE_CLOUDFLARED='ask'
UPDATE_TAILSCALE='ask'
UPDATE_MIHOMO='ask'
UPDATE_9ROUTER='ask'
UPDATE_HEADROOM='ask'
UPDATE_HERMES='ask'
UPDATE_HERMES_WEBUI='ask'
UPDATE_STORAGE_MANAGER='ask'
UPDATE_COPYPARTY='ask'
UPDATE_XUI='ask'

# --- CREDENTIALS (ganti setelah install!) ---
DEFAULT_ROOT_PASSWORD='changeme123'
LXC_ROOT_PASSWORD='changeme123'
HERMES_USER_PASSWORD='changeme123'
HERMES_WEBUI_ADMIN_PASSWORD='changeme123'
STORAGE_MANAGER_DEFAULT_PASSWORD='changeme123'
COPYPARTY_PASSWORD='changeme123'
# 3x-ui kredensial acak â†’ /etc/x-ui/install-result.env

# --- HOST ---
PVE_HOSTNAME='proxmox'
PVE_DOMAIN='local'
PVE_FQDN='proxmox.local'

# --- ALPINE LXC TEMPLATE (lightweight base image) ---
ALPINE_LXC_TEMPLATE=''
ALPINE_LXC_TEMPLATE_GLOB='alpine-3*-standard*.tar.zst'
ALPINE_LXC_VERSION='3.21'
ALPINE_LXC_AUTO_DOWNLOAD='yes'

# --- LXC BASE OS (global default) ---
# debian = full Debian 13 (default), alpine = lightweight Alpine 3.21
# Per-service override: <PREFIX>_LXC_TEMPLATE=alpine|debian (e.g. ROUTER9_LXC_TEMPLATE)
LXC_TEMPLATE='debian'

# --- DOCKER SERVICES (run inside LXC) ---
DOCKER_LXC_TEMPLATE='debian-13-standard'
DOCKER_LXC_CTID='200'
DOCKER_LXC_HOSTNAME='docker-host'
DOCKER_LXC_IP='10.10.40.200'
DOCKER_LXC_RAM_MB='4096'
DOCKER_LXC_DISK_GB='32'
DOCKER_LXC_FEATURES='nesting=1,keyctl=1'
DOCKER_COMPOSE_VERSION='2.27.0'
DOCKER_INSTALL_MODE='ask'
DOCKER_TARGET_CTID=''
DOCKER_DATA_DIR='/var/lib/docker'
DOCKER_REGISTRY_MIRROR=''

# --- BOOT ---
EXPECTED_ROOT_MAX_GIB='28'
EXPECTED_ROOT_TARGET_GIB='26'

# --- NETWORK ---
PVE_WAN_NIC='auto'
PVE_MGMT_IP='192.168.1.10'
PVE_MGMT_CIDR='24'
PVE_MGMT_GATEWAY='192.168.1.1'
PVE_DNS_1='1.1.1.1'
PVE_DNS_2='8.8.8.8'

VM_BR_MIKROTIK='vmbr30'
VM_BR_SERVICE='vmbr40'
VM_BR_TEST='vmbr50'
VM_BR_MIKROTIK_IP='10.10.30.1'
VM_BR_MIKROTIK_CIDR='24'
VM_BR_SERVICE_IP='10.10.40.1'
VM_BR_SERVICE_CIDR='24'
VM_BR_TEST_IP='10.10.50.1'
VM_BR_TEST_CIDR='24'
ENABLE_NAT_40='yes'

# --- DOMAIN ---
DOMAIN_ROOT='example.com'
DOMAIN_PVE="pve.${DOMAIN_ROOT}"
DOMAIN_NAS="nas.${DOMAIN_ROOT}"
DOMAIN_MIHOMO="mihomo.${DOMAIN_ROOT}"
DOMAIN_AI="ai.${DOMAIN_ROOT}"
DOMAIN_HERMES="hermes.${DOMAIN_ROOT}"
DOMAIN_CHAT="chat.${DOMAIN_ROOT}"
DOMAIN_VPN="vpn.${DOMAIN_ROOT}"

CLOUDFLARED_TOKEN=''
TAILSCALE_AUTHKEY=''

# --- MIHOMO ---
# (DEFAULT)
MIHOMO_VERSION='1.19.27'
MIHOMO_BIN_URL="https://github.com/MetaCubeX/mihomo/releases/download/v${MIHOMO_VERSION}/mihomo-linux-amd64-compatible-v${MIHOMO_VERSION}.gz"
MIHOMO_PORT_MIXED='7893'
MIHOMO_PORT_REDIR='7892'
MIHOMO_PORT_TPROXY='7895'
MIHOMO_DNS_PORT='1053'
MIHOMO_CONTROLLER='127.0.0.1:9090'
MIHOMO_SECRET='changeme'
MIHOMO_DIR='/etc/mihomo'
MIHOMO_UI_DIR='/etc/mihomo/ui'
MIHOMO_DASHBOARD_REPO='MetaCubeX/metacubexd'
MIHOMO_DASHBOARD_BRANCH='gh-pages'
MIHOMO_UI_URL='https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip'

# --- 9ROUTER ---
# (DEFAULT)
ROUTER9_CTID='101'
ROUTER9_HOSTNAME='9router'
ROUTER9_IP='10.10.40.10'
ROUTER9_GATEWAY='10.10.40.1'
ROUTER9_STORAGE='local'
ROUTER9_SWAP_MB='1024'
ROUTER9_NPM_PACKAGE='9router'
ROUTER9_PORT='20128'
ROUTER9_UNPRIVILEGED='1'
ROUTER9_FEATURES='nesting=1'
ROUTER9_DATA_DIR='/var/lib/9router'
ROUTER9_BASE_URL="https://${DOMAIN_AI}"
ROUTER9_CLOUDFLARE_TUNNEL='no'
NODE_MAJOR='22'

# --- HEADROOM (co-locate 9Router) ---
# (DEFAULT)
HEADROOM_EXTRAS='proxy,code,ml,mcp'
HEADROOM_CTID="${ROUTER9_CTID}"
HEADROOM_IP="${ROUTER9_IP}"
HEADROOM_PORT='8787'
HEADROOM_AUTH=''

# --- HERMES AGENT ---
# (DEFAULT)
HERMES_CTID='102'
HERMES_HOSTNAME='hermes-agent'
HERMES_IP='10.10.40.20'
HERMES_GATEWAY='10.10.40.1'
HERMES_SWAP_MB='2048'
HERMES_USER='hermes'
HERMES_PORT='8000'
HERMES_MCP_PORT='8001'
HERMES_SKIP_BROWSER='yes'
HERMES_OPENAI_BASE_URL="http://${HEADROOM_IP}:${HEADROOM_PORT}"
HERMES_MODEL_ID=''
TELEGRAM_BOT_TOKEN=''
TELEGRAM_ALLOWED_USER_IDS=''

# --- HERMES WEBUI ---
# (DEFAULT)
HERMES_WEBUI_CTID='103'
HERMES_WEBUI_HOSTNAME='hermes-webui'
HERMES_WEBUI_IP='10.10.40.30'
HERMES_WEBUI_CIDR='24'
HERMES_WEBUI_GATEWAY='10.10.40.1'
HERMES_WEBUI_RAM_MB='2048'
HERMES_WEBUI_SWAP_MB='1024'
HERMES_WEBUI_DISK_GB='24'
HERMES_WEBUI_HOST='0.0.0.0'
HERMES_WEBUI_PORT='3000'
HERMES_WEBUI_DATA_DIR='/var/lib/hermes-webui'
HERMES_WEBUI_AGENT_MODE='auto'
HERMES_WEBUI_AUTO_INSTALL='1'
HERMES_HOME_DIR='/var/lib/hermes-webui/.hermes'
HERMES_CONFIG_PATH='/var/lib/hermes-webui/.hermes/config.yaml'

# --- TTYD ---
# (DEFAULT)
TTYD_VERSION='latest'
TTYD_PORT='7681'
TTYD_USERNAME='admin'
TTYD_PASSWORD='changeme123'
TTYD_SHELL='/bin/bash'
TTYD_ENABLE_SERVICE='yes'

# --- OH MY ZSH ---
# (DEFAULT)
OHMYZSH_USERS='root'
OHMYZSH_THEME='robbyrussell'
OHMYZSH_PLUGINS='git sudo history systemd docker npm node zsh-autosuggestions zsh-syntax-highlighting'
OHMYZSH_SET_DEFAULT_SHELL='yes'
OHMYZSH_INSTALL_PLUGINS='yes'

# --- STORAGE MANAGER ---
# (DEFAULT)
STORAGE_MANAGER_CTID='104'
STORAGE_MANAGER_HOSTNAME='storage-manager'
STORAGE_MANAGER_IP='10.10.40.40'
STORAGE_MANAGER_CIDR='24'
STORAGE_MANAGER_GATEWAY='10.10.40.1'
STORAGE_MANAGER_RAM_MB='1024'
STORAGE_MANAGER_SWAP_MB='1024'
STORAGE_MANAGER_DISK_GB='16'
STORAGE_MANAGER_ROOT='/srv/storage'
STORAGE_MANAGER_USERS_CONFIG='/var/lib/storage-manager/users.yaml'
FILEBROWSER_PORT='8081'
FILEBROWSER_ROOT="${STORAGE_MANAGER_ROOT}"
FILEBROWSER_WEBDAV_ENABLED='yes'
SFTP_PORT='22'
SFTP_CHROOT_BASE="${STORAGE_MANAGER_ROOT}"
FTP_ENABLED='ask'
FTP_PORT='21'
FTP_PASV_MIN_PORT='30000'
FTP_PASV_MAX_PORT='30100'
SAMBA_ENABLED='ask'
SAMBA_PORT='445'
SAMBA_WORKGROUP='WORKGROUP'
SAMBA_BIND_INTERFACES_ONLY='yes'
SAMBA_ALLOWED_SUBNET='100.64.0.0/10'

# --- FASTFETCH ---
# (DEFAULT)
FASTFETCH_PRESET='homelab'
FASTFETCH_SHOW_ON_LOGIN='yes'

# --- COPYPARTY ---
# (DEFAULT)
COPYPARTY_CTID='105'
COPYPARTY_HOSTNAME='copyparty'
COPYPARTY_IP='10.10.40.50'
COPYPARTY_CIDR='24'
COPYPARTY_GATEWAY='10.10.40.1'
COPYPARTY_RAM_MB='512'
COPYPARTY_SWAP_MB='512'
COPYPARTY_DISK_GB='8'
COPYPARTY_PORT='3923'
COPYPARTY_ROOT='/srv/copyparty'

# --- 3X-UI ---
XUI_CTID='106'
XUI_HOSTNAME='xui'
XUI_IP='10.10.40.60'
XUI_CIDR='24'
XUI_GATEWAY='10.10.40.1'
XUI_RAM_MB='1024'
XUI_SWAP_MB='1024'
XUI_DISK_GB='10'
XUI_NONINTERACTIVE='1'
XUI_DB_MODE='sqlite'
XUI_DB_PATH='/etc/x-ui/x-ui.db'
XUI_ENV_FILE='/etc/default/x-ui'
XUI_RESULT_FILE='/etc/x-ui/install-result.env'

# --- MIKROTIK CHR ---
MIKROTIK_VMID='100'
MIKROTIK_NAME='mikrotik-chr'
MIKROTIK_RAM_MB='512'
MIKROTIK_DISK_GB='1'
MIKROTIK_CHR_URL='https://github.com/elseif/MikroTikPatch/releases/download/7.23.1/chr-7.23.1-legacy-bios.qcow2.zip'
MIKROTIK_WAN_IP='10.10.30.2'
MIKROTIK_WAN_GATEWAY='10.10.30.1'
MIKROTIK_WINBOX_PORT='8291'
# --- MIKROTIK REMOTE ACCESS (WinBox external) ---
# NAT: forward port publik -> MikroTik VM (winbox external via IP)
MIKROTIK_NAT_ENABLE='yes'
MIKROTIK_NAT_PUBLIC_IF='vmbr0'       # interface publik/WAN host
MIKROTIK_NAT_TARGET_IP='10.10.30.2'  # IP MikroTik tujuan (WAN)
# Cloudflare Tunnel TCP untuk WinBox (butuh service cloudflared terpasang)
MIKROTIK_CF_TUNNEL_ENABLE='no'
MIKROTIK_CF_TUNNEL_NAME='mikrotik'
MIKROTIK_CF_TUNNEL_DOMAIN='winbox.helminet.my.id'

# --- REGISTRY P3 ---
REGISTRY_STATE_FILE='/var/lib/homelab/allocations.json'
REGISTRY_SCHEMA_FILE='config/registry/allocations.schema.json'
REGISTRY_LOCK_FILE='/var/lib/homelab/allocations.lock'

# --- LXC DEFAULTS ---
LXC_DEFAULT_RAM_MB='2048'
LXC_DEFAULT_SWAP_MB='1024'
LXC_DEFAULT_DISK_GB='8'
LXC_DEFAULT_CORES='2'
LXC_DEFAULT_BRIDGE='vmbr40'
LXC_DEFAULT_STORAGE='local'
LXC_DEFAULT_ONBOOT='1'
LXC_DEFAULT_UNPRIVILEGED='1'
LXC_DEFAULT_FEATURES='nesting=1'

# --- GITHUB ---
GITHUB_OWNER='your-username'
GITHUB_REPO='aio-proxmox'
GITHUB_BRANCH='main'
GITHUB_TOKEN=''
REPO_INSTALL_DIR='/root/aio-proxmox'
HOMELAB_REPO_REMOTE='auto'
HOMELAB_UPDATE_METHOD='auto'
HOMELAB_KEEP_ENV='yes'

# --- DEBIAN UPGRADE (P9) ---
DEBIAN_UPGRADE_ENABLED='yes'
DEBIAN_TARGET_VERSION='13.6.0'
DEBIAN_UPGRADE_REBOOT='ask'

# --- PROXMOX REPAIR (P10) ---
PROXMOX_REPAIR_ENABLED='yes'
PROXMOX_REPAIR_PRESERVE_LXC='yes'
PROXMOX_REPAIR_PRESERVE_VM='yes'

# --- LOGGING ---
SYSLOG_SERVER=''
LOG_RETENTION='2week'
LOG_DIR='/var/log/homelab'

# --- BACKUP ---
BACKUP_DIR='/mnt/usb/proxmox-backup'
