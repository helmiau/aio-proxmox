{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Homelab Allocations Registry",
  "type": "object",
  "properties": {
    "allocations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "port": { "type": "integer" },
          "service": { "type": "string" },
          "target": { "type": "string", "enum": ["host", "lxc", "vm"] },
          "ctid": { "type": "string" }
        },
        "required": ["port", "service"]
      }
    }
  }
}
