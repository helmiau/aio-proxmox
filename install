#!/bin/bash
# install — main interactive installer for aio-proxmox v4.2
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$REPO_ROOT/lib/logging.sh"
source "$REPO_ROOT/lib/common.sh"
source "$REPO_ROOT/lib/service-actions.sh"
source "$REPO_ROOT/lib/env-manager.sh"

# P13: --version flag
if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
    echo "aio-proxmox $(get_script_version)"
    exit 0
fi

# P8: Auto-init ENVIRONMENT if missing
init_env
load_env

# Service index mapping
SERVICES=(cloudflared tailscale mihomo 9router headroom hermes hermes-webui storage copyparty xui ttyd ohmyzsh fastfetch health mikrotik)

service_name_by_index() {
    local idx="$1"
    if [[ "$idx" =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= ${#SERVICES[@]} )); then
        echo "${SERVICES[$((idx-1))]}"
        return 0
    fi
    return 1
}

# Parse selection like "1-1,2" or "1-1" or "1" → action + list of services
parse_selection() {
    local input="$1"
    local action="" services=()
    
    if [[ "$input" =~ ^([1-4])-(.+)$ ]]; then
        action="${BASH_REMATCH[1]}"
        local list="${BASH_REMATCH[2]}"
        IFS=',' read -ra parts <<< "$list"
        for p in "${parts[@]}"; do
            local svc=""
            if svc=$(service_name_by_index "$p"); then
                services+=("$svc")
            else
                services+=("$p")
            fi
        done
    else
        # Single service name (no action prefix) → default install
        action="1"
        if svc=$(service_name_by_index "$input"); then
            services+=("$svc")
        else
            services+=("$input")
        fi
    fi
    
    echo "$action"
    printf '%s\n' "${services[@]}"
}

# Management action name
action_name() {
    case "$1" in
        1) echo "install" ;;
        2) echo "update" ;;
        3) echo "uninstall" ;;
        4) echo "reinstall" ;;
    esac
}

manage_services() {
    echo ""
    echo "--- Available Services ---"
    local i=1
    for s in "${SERVICES[@]}"; do
        printf "%2d) %s\n" "$i" "$s"
        ((i++))
    done
    echo ""
    echo "Input format: <action>-<service1>,<service2>"
    echo "  action: 1=install, 2=update, 3=uninstall, 4=reinstall"
    echo "  service: number or name (e.g. 1-1,2 = install cloudflared + tailscale)"
    echo "  single: '1' = install service #1, or type service name directly"
    echo ""
    read -r -p "Your input (e.g. 1-1,2): " sel
    
    local action services=()
    local parsed
    parsed=$(parse_selection "$sel")
    action=$(echo "$parsed" | head -1)
    services=($(echo "$parsed" | tail -n +2))
    
    local action_str
    action_str=$(action_name "$action")
    
    for svc in "${services[@]}"; do
        log_info "→ ${action_str}: ${svc}"
        case "$action_str" in
            install) install_service "$svc" ;;
            update) update_service "$svc" ;;
            uninstall) uninstall_service "$svc" ;;
            reinstall) reinstall_service "$svc" ;;
        esac
    done
}

pick_lxc_template() {
    # --- Step 1: storage selection ---
    local -a storages
    mapfile -t storages < <(pvesm status -content vztmpl 2>/dev/null | awk 'NR>1 {print $1}')
    local storage=""
    if (( ${#storages[@]} > 0 )); then
        echo ""
        echo "--- Available Storages (vztmpl) ---"
        local si=1
        for s in "${storages[@]}"; do
            echo "  $si) $s"
            si=$((si+1))
        done
        read -r -p "Select storage (number) or type custom name (q=cancel): " s_choice
        [[ "$s_choice" == "q" || -z "$s_choice" ]] && { echo ""; return 1; }
        if [[ "$s_choice" =~ ^[0-9]+$ ]] && (( s_choice >= 1 && s_choice <= ${#storages[@]} )); then
            storage="${storages[$((s_choice-1))]}"
        else
            storage="$s_choice"
        fi
    else
        read -r -p "No vztmpl storage found. Type storage name (e.g. local): " storage
        [[ -z "$storage" ]] && { echo ""; return 1; }
    fi

    # --- Step 2: template listing (downloaded first, --- separator, then available) ---
    local -a dl avail
    mapfile -t dl < <(pveam list "$storage" 2>/dev/null | awk 'NR>1 {print $1}' | sed 's/^[^:]*:\?vztmpl\///')
    mapfile -t avail < <(pveam available 2>/dev/null | awk 'NR>1 {print $2}')
    # available not yet downloaded
    local -a avail_only=()
    local t
    for t in "${avail[@]:-}"; do
        [[ -n "$t" ]] || continue
        grep -qxF "$t" <(printf '%s\n' "${dl[@]}") || avail_only+=("$t")
    done

    local total=$(( ${#dl[@]} + ${#avail_only[@]} ))
    echo ""
    echo "--- LXC Templates on $storage ---"
    local i=1
    if (( ${#dl[@]} > 0 )); then
        for t in "${dl[@]}"; do
            [[ -n "$t" ]] || continue
            echo "  $i) $t (downloaded)"
            i=$((i+1))
        done
        echo "  -----"
    else
        echo "  (no downloaded templates on $storage)"
    fi
    if (( ${#avail_only[@]} > 0 )); then
        for t in "${avail_only[@]}"; do
            echo "  $i) $t"
            i=$((i+1))
        done
    else
        echo "  (no available templates)"
    fi
    echo ""
    if (( total == 0 )); then
        echo "No templates found. Run: pveam update"
        return 1
    fi

    # --- Step 3: selection by number / keyword / full name ---
    local picked=""
    while [[ -z "$picked" ]]; do
        read -r -p "Select template (number / keyword e.g. debian-13 / full name, q=cancel): " choice
        [[ "$choice" == "q" || -z "$choice" ]] && { echo ""; return 1; }

        if [[ "$choice" =~ ^[0-9]+$ ]]; then
            local n=1 ok=0
            for t in "${dl[@]}"; do
                [[ -n "$t" ]] || continue
                if (( n == choice )); then picked="$t"; ok=1; break; fi
                n=$((n+1))
            done
            if (( !ok )); then
                for t in "${avail_only[@]}"; do
                    if (( n == choice )); then picked="$t"; ok=1; break; fi
                    n=$((n+1))
                done
            fi
            (( ok )) || { echo "Invalid number (1-$total)"; continue; }
        else
            # keyword / full name — exact match first, then substring
            local -a matches=()
            for t in "${dl[@]}" "${avail_only[@]}"; do
                [[ -n "$t" ]] || continue
                if [[ "$t" == "$choice" ]]; then
                    matches=("$t"); break
                elif [[ "$t" == *"$choice"* ]]; then
                    matches+=("$t")
                fi
            done
            case "${#matches[@]}" in
                0) echo "No match for '$choice'"; continue ;;
                1) picked="${matches[0]}" ;;
                *)
                    echo "Multiple matches:"
                    local mi=1
                    for t in "${matches[@]}"; do
                        echo "  $mi) $t"
                        mi=$((mi+1))
                    done
                    read -r -p "Choose number: " mi_choice
                    [[ "$mi_choice" =~ ^[0-9]+$ ]] && (( mi_choice >= 1 && mi_choice <= ${#matches[@]} )) \
                        && picked="${matches[$((mi_choice-1))]}" || { echo "Invalid"; continue; }
                    ;;
            esac
        fi
    done

    # --- Step 4: auto-download if not downloaded ---
    if ! grep -qxF "$picked" <(printf '%s\n' "${dl[@]}"); then
        echo "Template not downloaded — downloading..."
        pveam download "$storage" "$picked" || { echo "Download failed"; return 1; }
    fi

    echo "$storage:vztmpl/$picked"
}

manage_lxc() {
    echo ""
    echo "--- LXC Container Management (pct) ---"
    echo "1) List containers"
    echo "2) Start container"
    echo "3) Stop container"
    echo "4) Restart container"
    echo "5) Enter shell (pct enter)"
    echo "6) Create container"
    echo "7) Destroy container"
    echo "q) Back to main menu"
    echo ""
    read -r -p "LXC action: " lxc_opt
    
    case "$lxc_opt" in
        1) pct list ;;
        2) read -r -p "CTID: " ctid; pct start "$ctid" ;;
        3) read -r -p "CTID: " ctid; pct stop "$ctid" ;;
        4) read -r -p "CTID: " ctid; pct reboot "$ctid" ;;
        5) read -r -p "CTID: " ctid; pct enter "$ctid" ;;
        6)
            read -r -p "CTID: " ctid
            read -r -p "Hostname: " host
            local tmpl
            tmpl=$(pick_lxc_template)
            [[ -z "$tmpl" ]] && { echo "No template selected"; return; }
            local storage="${tmpl%%:vztmpl/*}"
            pct create "$ctid" "$tmpl" \
                --hostname "$host" --storage "$storage" \
                --net0 "name=eth0,bridge=vmbr0,ip=dhcp" --unprivileged 1
            ;;
        7)
            read -r -p "CTID: " ctid
            read -r -p "Destroy container $ctid? (y/N): " confirm
            [[ "$confirm" == "y" ]] && pct destroy "$ctid"
            ;;
        q) return 0 ;;
        *) echo "Invalid option" ;;
    esac
}

show_menu() {
  clear
  echo "===================================================="
  echo "   aio-proxmox $(get_script_version) — Homelab Installer"
  echo "===================================================="
  echo "0)  Check Environment"
  echo "1)  Debian Base Setup (incl. 13.6.0 upgrade)"
  echo "2)  Check Root Size (26 GiB)"
  echo "3)  Install Proxmox VE 9"
  echo "4)  Configure Bridges & NAT"
  echo "5)  Manage Services (Install/Update/Uninstall/Reinstall)"
  echo "6)  Repair/Reinstall Proxmox"
  echo "7)  Upgrade Debian (Standalone)"
  echo "8)  Update Services"
  echo "9)  Update Repo (git pull)"
  echo "10) Manage LXC (pct)"
  echo "11) Edit ENVIRONMENT (nano)"
  echo "q)  Quit"
  echo "----------------------------------------------------"
}

while true; do
  show_menu
  read -r -p "Select option: " opt
  case "$opt" in
    0) bash "$REPO_ROOT/scripts/00-check-env.sh" ;;
    1) bash "$REPO_ROOT/scripts/01-debian-base.sh" ;;
    2) bash "$REPO_ROOT/scripts/02-check-root-26gb.sh" ;;
    3) bash "$REPO_ROOT/scripts/03-install-proxmox-ve9.sh" install ;;
    4) bash "$REPO_ROOT/scripts/04-proxmox-bridges-nat.sh" ;;
    5) manage_services ;;
    6) bash "$REPO_ROOT/scripts/03-install-proxmox-ve9.sh" repair ;;
    7) bash "$REPO_ROOT/scripts/upgrade-debian.sh" ;;
    8) bash "$REPO_ROOT/updater" ;;
    9) git -C "$REPO_ROOT" pull ;;
    10) manage_lxc ;;
    11) edit_env ;;
    q) exit 0 ;;
    *) echo "Invalid option" ;;
  esac
  read -r -p "Press enter to continue..."
done
